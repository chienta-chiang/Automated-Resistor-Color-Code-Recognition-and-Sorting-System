// secrets.h template -> copy this file to "arduino_secrets.h" (same folder) and fill in your values.
// "arduino_secrets.h" is listed in .gitignore and must never be committed.
#ifndef ARDUINO_SECRETS_H
#define ARDUINO_SECRETS_H

#define SECRET_WIFI_SSID "YOUR_WIFI_SSID"
#define SECRET_WIFI_PASSWORD "YOUR_WIFI_PASSWORD"

// Computer running src/vision/upload_server.py (or the original XAMPP/PHP receiver)
#define SECRET_SERVER_HOST "192.168.0.100"  // that computer's LAN IP address
#define SECRET_SERVER_PORT 8080             // must match upload_server.port in settings.yaml
#define SECRET_UPLOAD_PATH "/upload/upload.php"

#endif  // ARDUINO_SECRETS_H
